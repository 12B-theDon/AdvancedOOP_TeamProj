# Local builds and IDE state.
/build*/
/out/
/.vs/
/.vscode/
CMakeUserPresets.json

# Generated data, all fine-tuned/experimental weights, caches and validation outputs.
# Keep these files locally; only the README and pretrained exceptions below are versioned.
/data/augmented/
/model/
/models/*
!/models/readme.md
*.partial

# Include only the pretrained encoder needed for team fine-tuning.
!/models/pretrained/
/models/pretrained/*
!/models/pretrained/deepprint.bin
!/models/pretrained/deepprint.json

# External source contents belong to the registered Git submodule.
# Only its pinned Git entry is tracked by this repository.
/third_party/deepprint/**

# Local Python environments and caches.
/.venv*/
*.pyc
*.pyo
.DS_Store
__pycache__/

# Local drawing rules; keep generated figures and the model conversion tool versioned.
/tools/readme.md

# Local raw GUI verification outputs; keep the explanatory README.
/docs/GUI_flows/captures/*
!/docs/GUI_flows/captures/readme.md

# Local reference paper and diagram PDF exports.
/Deepprint.pdf
/output/pdf/deepprint_blocks.pdf
/output/pdf/deepprint_finetuning.pdf
