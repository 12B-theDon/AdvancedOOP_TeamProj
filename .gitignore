# Local builds and IDE state.
/build*/
/out/
/.vs/
/.vscode/
CMakeUserPresets.json

# Generated data, experimental weights, caches and validation outputs.
/data/augmented/
/model/
/models/*
!/models/readme.md
*.partial

# Include the pretrained encoder and the four distributed production models.
!/models/pretrained/
/models/pretrained/*
!/models/pretrained/deepprint.bin
!/models/pretrained/deepprint.json
!/models/trained_result/
/models/trained_result/*
!/models/trained_result/fvc2000_db3.bin
!/models/trained_result/fvc2002_db3.bin
!/models/trained_result/fvc2004_db1.bin
!/models/trained_result/combined.bin
!/models/trained_result/weights.json

# External source contents belong to the registered Git submodule.
# Only its pinned Git entry is tracked by this repository.
/third_party/deepprint/**

# Local Python environments and caches.
/.venv*/
*.pyc
*.pyo
.DS_Store
__pycache__/

# Local drawing rules; keep generated figures and the model conversion tool versioned.
/tools/readme.md

# Local reference paper and diagram PDF exports.
/Deepprint.pdf
/output/pdf/deepprint_blocks.pdf
/output/pdf/deepprint_finetuning.pdf

# Deployment packages and generated focused-test outputs.
/dist/
/tests/output/
