function(check_destination)
    if(NOT DESTINATION OR NOT SOURCE)
        message(FATAL_ERROR "Package destination and source are required.")
    endif()
    get_filename_component(destination "${DESTINATION}" ABSOLUTE)
    get_filename_component(source "${SOURCE}" ABSOLUTE)
    # A package output may never replace source, original data, or its own inputs.
    cmake_path(IS_PREFIX destination "${source}" NORMALIZE contains_source)
    set(original "${source}/data/original")
    cmake_path(IS_PREFIX original "${destination}" NORMALIZE inside_original)
    foreach(input IN ITEMS "${ALGORITHM_DLL}" "${CORE_DLL}" "${WORKER_EXE}" "${GUI_EXE}" "${INSTALLER_EXE}" "${MODELS}")
        if(input)
            cmake_path(IS_PREFIX destination "${input}" NORMALIZE contains_input)
            if(contains_input)
                message(FATAL_ERROR "Package destination would replace input: ${input}")
            endif()
        endif()
    endforeach()
    if(contains_source OR inside_original)
        message(FATAL_ERROR "Package destination would replace protected source/original data.")
    endif()
endfunction()
function(copy_torch_licenses torch_root stage)
    file(GLOB_RECURSE licenses LIST_DIRECTORIES FALSE
        "${torch_root}/*LICENSE*" "${torch_root}/*NOTICE*"
        "${torch_root}/*license*" "${torch_root}/*notice*")
    if(licenses)
        foreach(license IN LISTS licenses)
            file(RELATIVE_PATH relative "${torch_root}" "${license}")
            get_filename_component(parent "${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${stage}/licenses/LibTorch/${parent}")
            file(COPY "${license}" DESTINATION "${stage}/licenses/LibTorch/${parent}")
        endforeach()
        return()
    endif()

    # Official Windows LibTorch ZIPs may omit notices. Use the notices from the
    # official CPU wheel only when the version AND PyTorch build hash match.
    foreach(metadata build-version build-hash)
        if(NOT EXISTS "${torch_root}/${metadata}")
            message(FATAL_ERROR "LibTorch notices are absent and ${metadata} is missing from ${torch_root}.")
        endif()
    endforeach()
    file(READ "${torch_root}/build-version" version)
    file(READ "${torch_root}/build-hash" build_hash)
    string(STRIP "${version}" version)
    string(STRIP "${build_hash}" build_hash)
    if(NOT version MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)\\+cpu$")
        message(FATAL_ERROR "LibTorch ${version} has no bundled notices. Provide notices for this exact distribution.")
    endif()
    set(bundle "${SOURCE}/third_party/libtorch-notices/windows-cpu-${CMAKE_MATCH_1}")
    if(NOT EXISTS "${bundle}/provenance.json")
        message(FATAL_ERROR "LibTorch ${version} has no matching notice bundle: ${bundle}")
    endif()
    file(READ "${bundle}/provenance.json" provenance)
    string(JSON format GET "${provenance}" format)
    string(JSON notice_version GET "${provenance}" libtorch_version)
    string(JSON notice_build GET "${provenance}" libtorch_build_hash)
    if(NOT format STREQUAL "fingerprint-libtorch-notices-v1"
        OR NOT version STREQUAL notice_version OR NOT build_hash STREQUAL notice_build)
        message(FATAL_ERROR "LibTorch notice version/build does not match ${version} (${build_hash}).")
    endif()
    set(notice "${bundle}/LICENSES.txt")
    if(NOT EXISTS "${notice}")
        message(FATAL_ERROR "LibTorch notice bundle is incomplete: ${notice}")
    endif()
    string(JSON expected GET "${provenance}" notice_sha256)
    file(SHA256 "${notice}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "LibTorch notice SHA-256 mismatch: ${notice}")
    endif()
    file(MAKE_DIRECTORY "${stage}/licenses/LibTorch")
    file(COPY "${notice}" "${bundle}/provenance.json" DESTINATION "${stage}/licenses/LibTorch")
    message(STATUS "LibTorch notices: matched official Windows CPU version/build ${version} (${build_hash}).")
endfunction()
function(copy_qt_licenses qt_bin stage)
    get_filename_component(qt_root "${qt_bin}" DIRECTORY)
    file(GLOB licenses LIST_DIRECTORIES FALSE "${qt_root}/LICENSE*" "${qt_root}/NOTICE*")
    foreach(folder licenses LICENSES doc/licenses doc/global/licenses)
        file(GLOB_RECURSE nested LIST_DIRECTORIES FALSE "${qt_root}/${folder}/*")
        list(APPEND licenses ${nested})
    endforeach()
    list(REMOVE_DUPLICATES licenses)
    if(licenses)
        foreach(license IN LISTS licenses)
            file(RELATIVE_PATH relative "${qt_root}" "${license}")
            get_filename_component(parent "${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${stage}/licenses/Qt/${parent}")
            file(COPY "${license}" DESTINATION "${stage}/licenses/Qt/${parent}")
        endforeach()
        return()
    endif()

    # aqt installs the binary archives; their SDK directory can lack notices.
    # qconfig.pri is generated by Qt from PROJECT_VERSION, independently of setup.
    if(NOT EXISTS "${qt_root}/mkspecs/qconfig.pri")
        message(FATAL_ERROR "Qt notices are absent and mkspecs/qconfig.pri is missing from ${qt_root}.")
    endif()
    file(STRINGS "${qt_root}/mkspecs/qconfig.pri" version_line REGEX "^QT_VERSION[ \t]*=")
    if(NOT version_line MATCHES "^QT_VERSION[ \t]*=[ \t]*([0-9]+\\.[0-9]+\\.[0-9]+)[ \t]*$")
        message(FATAL_ERROR "Cannot identify the Qt version for notice packaging: ${qt_root}")
    endif()
    set(version "${CMAKE_MATCH_1}")
    set(bundle "${SOURCE}/third_party/qt-notices/${version}")
    if(NOT EXISTS "${bundle}/provenance.json")
        message(FATAL_ERROR "Qt ${version} has no matching notice bundle: ${bundle}")
    endif()
    file(READ "${bundle}/provenance.json" provenance)
    string(JSON format GET "${provenance}" format)
    string(JSON notice_version GET "${provenance}" qt_version)
    if(NOT format STREQUAL "fingerprint-qt-notices-v1" OR NOT version STREQUAL notice_version)
        message(FATAL_ERROR "Qt notice version does not match ${version}.")
    endif()
    set(notice "${bundle}/LICENSES.txt")
    if(NOT EXISTS "${notice}")
        message(FATAL_ERROR "Qt notice bundle is incomplete: ${notice}")
    endif()
    string(JSON expected GET "${provenance}" notice_sha256)
    file(SHA256 "${notice}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Qt notice SHA-256 mismatch: ${notice}")
    endif()
    file(MAKE_DIRECTORY "${stage}/licenses/Qt")
    file(COPY "${notice}" "${bundle}/provenance.json" DESTINATION "${stage}/licenses/Qt")
    message(STATUS "Qt notices: matched official source version ${version} (Base, SVG, Image Formats).")
endfunction()
function(write_manifest stage)
    file(GLOB_RECURSE packaged RELATIVE "${stage}" LIST_DIRECTORIES FALSE "${stage}/*")
    list(SORT packaged)
    set(manifest "")
    foreach(path IN LISTS packaged)
        if(path STREQUAL "SHA256SUMS.txt")
            continue()
        endif()
        file(SHA256 "${stage}/${path}" digest)
        string(APPEND manifest "${digest}  ${path}\n")
    endforeach()
    if(ARGC GREATER 1)
        file(WRITE "${ARGV1}" "${manifest}")
    else()
        file(WRITE "${stage}/SHA256SUMS.txt" "${manifest}")
    endif()
endfunction()

# Publish only managed files. Unknown datasets/reports remain in place, and a
# failed replacement restores every file already changed in this transaction.
function(publish_package stage)
    if(IS_SYMLINK "${DESTINATION}")
        message(FATAL_ERROR "Package destination must not be a symlink.")
    endif()
    if(EXISTS "${DESTINATION}/install.exe" AND RUNNING_INSTALLER)
        get_filename_component(running "${RUNNING_INSTALLER}" ABSOLUTE)
        get_filename_component(installer "${DESTINATION}/install.exe" ABSOLUTE)
        string(TOLOWER "${running}" running)
        string(TOLOWER "${installer}" installer)
        if(running STREQUAL installer)
            file(COPY_FILE "${DESTINATION}/install.exe" "${stage}/install.exe")
            message(STATUS "Preserving the currently running install.exe.")
        endif()
    endif()
    write_manifest("${stage}")
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
    set(backup "${DESTINATION}.rollback-${token}")
    file(MAKE_DIRECTORY "${backup}" "${DESTINATION}")
    file(GLOB_RECURSE inputs RELATIVE "${stage}" LIST_DIRECTORIES FALSE "${stage}/*")
    file(GLOB_RECURSE existing RELATIVE "${DESTINATION}" LIST_DIRECTORIES FALSE "${DESTINATION}/*")
    # Read and validate the complete future inventory before replacing any file.
    # This includes unknown user files, which remain untouched.
    set(inventory ${inputs} ${existing})
    list(REMOVE_DUPLICATES inventory)
    list(SORT inventory)
    set(merged "")
    foreach(relative IN LISTS inventory)
        if(relative STREQUAL "SHA256SUMS.txt")
            continue()
        endif()
        if(IS_SYMLINK "${DESTINATION}/${relative}")
            message(FATAL_ERROR "Cannot package a symlink: ${DESTINATION}/${relative}")
        endif()
        if(relative IN_LIST inputs)
            if(IS_DIRECTORY "${DESTINATION}/${relative}")
                message(FATAL_ERROR "A user directory occupies a managed file path: ${relative}")
            endif()
            get_filename_component(parent "${DESTINATION}/${relative}" DIRECTORY)
            while(NOT parent STREQUAL DESTINATION)
                if(IS_SYMLINK "${parent}")
                    message(FATAL_ERROR "Cannot publish through a directory symlink: ${parent}")
                endif()
                get_filename_component(next_parent "${parent}" DIRECTORY)
                if(next_parent STREQUAL parent)
                    break()
                endif()
                set(parent "${next_parent}")
            endwhile()
            file(SHA256 "${stage}/${relative}" digest)
        else()
            file(SHA256 "${DESTINATION}/${relative}" digest)
        endif()
        string(APPEND merged "${digest}  ${relative}\n")
    endforeach()
    file(WRITE "${backup}/manifest.new" "${merged}")
    set(changed "")
    set(failure "")
    foreach(relative IN LISTS inputs)
        if(relative STREQUAL "SHA256SUMS.txt")
            continue()
        endif()
        set(target "${DESTINATION}/${relative}")
        if(IS_SYMLINK "${target}")
            set(failure "Refusing a symlink at a managed output: ${target}")
            break()
        endif()
        if(EXISTS "${target}")
            file(SHA256 "${target}" old_hash)
            file(SHA256 "${stage}/${relative}" new_hash)
            if(old_hash STREQUAL new_hash)
                continue()
            endif()
            get_filename_component(parent "${backup}/${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${parent}")
            file(COPY_FILE "${target}" "${backup}/${relative}" RESULT copied)
            if(NOT copied STREQUAL "0")
                set(failure "Cannot back up ${target}: ${copied}")
                break()
            endif()
        endif()
        get_filename_component(parent "${target}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        set(pending "${target}.install-new-${token}")
        file(COPY_FILE "${stage}/${relative}" "${pending}" RESULT copied)
        if(copied STREQUAL "0")
            file(RENAME "${pending}" "${target}" RESULT copied)
        endif()
        if(NOT copied STREQUAL "0")
            file(REMOVE "${pending}")
            set(failure "Cannot replace ${target}; close applications using this package. ${copied}")
            break()
        endif()
        list(APPEND changed "${relative}")
    endforeach()
    if(NOT failure)
        file(RENAME "${backup}/manifest.new" "${DESTINATION}/SHA256SUMS.txt" RESULT written)
        if(NOT written STREQUAL "0")
            set(failure "Cannot publish the deployment manifest: ${written}")
        endif()
    endif()
    if(failure)
        list(REVERSE changed)
        foreach(relative IN LISTS changed)
            if(EXISTS "${backup}/${relative}")
                file(COPY_FILE "${backup}/${relative}" "${DESTINATION}/${relative}" RESULT restored)
                if(NOT restored STREQUAL "0")
                    message(WARNING "Restore ${relative} from ${backup}: ${restored}")
                endif()
            else()
                file(REMOVE "${DESTINATION}/${relative}")
            endif()
        endforeach()
        message(FATAL_ERROR "${failure}. Previous-file backups: ${backup}")
    endif()
    # Preserve any replaced model archive instead of discarding user-trained weights.
    file(GLOB_RECURSE old_models RELATIVE "${backup}" "${backup}/*.bin")
    foreach(relative IN LISTS old_models)
        get_filename_component(parent "${DESTINATION}.preserved-models/${token}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${backup}/${relative}" "${DESTINATION}.preserved-models/${token}/${relative}")
    endforeach()
    file(REMOVE_RECURSE "${backup}" "${stage}")
endfunction()

# Installer inputs come from a fresh package stage, never unknown user files in dist.
function(snapshot_installer_payload stage package_name)
    if(NOT INSTALLER_PAYLOAD_ROOT)
        return()
    endif()
    if(NOT package_name MATCHES "^Fingerprint(Algorithm|Evaluator)$" OR NOT BUILD_ROOT)
        message(FATAL_ERROR "Invalid installer payload destination.")
    endif()
    get_filename_component(build "${BUILD_ROOT}" ABSOLUTE)
    get_filename_component(root "${INSTALLER_PAYLOAD_ROOT}" ABSOLUTE)
    cmake_path(IS_PREFIX build "${root}" NORMALIZE in_build)
    if(NOT in_build OR root STREQUAL build OR IS_SYMLINK "${root}")
        message(FATAL_ERROR "Installer payload must be a dedicated folder under the build directory.")
    endif()
    set(snapshot "${root}/${package_name}")
    if(IS_SYMLINK "${snapshot}")
        message(FATAL_ERROR "Installer payload must not be a symlink.")
    endif()
    write_manifest("${stage}")
    file(REMOVE_RECURSE "${snapshot}")
    file(MAKE_DIRECTORY "${snapshot}")
    file(COPY "${stage}/" DESTINATION "${snapshot}")
endfunction()
