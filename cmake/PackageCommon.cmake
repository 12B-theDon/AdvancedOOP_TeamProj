function(check_destination)
    if(NOT DESTINATION OR NOT SOURCE)
        message(FATAL_ERROR "Package destination and source are required.")
    endif()
    get_filename_component(destination "${DESTINATION}" ABSOLUTE)
    get_filename_component(source "${SOURCE}" ABSOLUTE)
    # A package output may never replace source, original data, or its own inputs.
    cmake_path(IS_PREFIX destination "${source}" NORMALIZE contains_source)
    set(original "${source}/data/original")
    cmake_path(IS_PREFIX original "${destination}" NORMALIZE inside_original)
    foreach(input IN ITEMS "${ALGORITHM_DLL}" "${CORE_DLL}" "${WORKER_EXE}" "${GUI_EXE}" "${MODELS}")
        if(input)
            cmake_path(IS_PREFIX destination "${input}" NORMALIZE contains_input)
            if(contains_input)
                message(FATAL_ERROR "Package destination would replace input: ${input}")
            endif()
        endif()
    endforeach()
    if(contains_source OR inside_original)
        message(FATAL_ERROR "Package destination would replace protected source/original data.")
    endif()
endfunction()
function(copy_torch_licenses torch_root stage)
    file(GLOB_RECURSE licenses LIST_DIRECTORIES FALSE
        "${torch_root}/*LICENSE*" "${torch_root}/*NOTICE*"
        "${torch_root}/*license*" "${torch_root}/*notice*")
    if(licenses)
        foreach(license IN LISTS licenses)
            file(RELATIVE_PATH relative "${torch_root}" "${license}")
            get_filename_component(parent "${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${stage}/licenses/LibTorch/${parent}")
            file(COPY "${license}" DESTINATION "${stage}/licenses/LibTorch/${parent}")
        endforeach()
        return()
    endif()

    # Official Windows LibTorch ZIPs may omit notices. Use the notices from the
    # official CPU wheel only when the version AND PyTorch build hash match.
    foreach(metadata build-version build-hash)
        if(NOT EXISTS "${torch_root}/${metadata}")
            message(FATAL_ERROR "LibTorch notices are absent and ${metadata} is missing from ${torch_root}.")
        endif()
    endforeach()
    file(READ "${torch_root}/build-version" version)
    file(READ "${torch_root}/build-hash" build_hash)
    string(STRIP "${version}" version)
    string(STRIP "${build_hash}" build_hash)
    if(NOT version MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)\\+cpu$")
        message(FATAL_ERROR "LibTorch ${version} has no bundled notices. Provide notices for this exact distribution.")
    endif()
    set(bundle "${SOURCE}/third_party/libtorch-notices/windows-cpu-${CMAKE_MATCH_1}")
    if(NOT EXISTS "${bundle}/provenance.json")
        message(FATAL_ERROR "LibTorch ${version} has no matching notice bundle: ${bundle}")
    endif()
    file(READ "${bundle}/provenance.json" provenance)
    string(JSON format GET "${provenance}" format)
    string(JSON notice_version GET "${provenance}" libtorch_version)
    string(JSON notice_build GET "${provenance}" libtorch_build_hash)
    if(NOT format STREQUAL "fingerprint-libtorch-notices-v1"
        OR NOT version STREQUAL notice_version OR NOT build_hash STREQUAL notice_build)
        message(FATAL_ERROR "LibTorch notice version/build does not match ${version} (${build_hash}).")
    endif()
    set(notice "${bundle}/LICENSES.txt")
    if(NOT EXISTS "${notice}")
        message(FATAL_ERROR "LibTorch notice bundle is incomplete: ${notice}")
    endif()
    string(JSON expected GET "${provenance}" notice_sha256)
    file(SHA256 "${notice}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "LibTorch notice SHA-256 mismatch: ${notice}")
    endif()
    file(MAKE_DIRECTORY "${stage}/licenses/LibTorch")
    file(COPY "${notice}" "${bundle}/provenance.json" DESTINATION "${stage}/licenses/LibTorch")
    message(STATUS "LibTorch notices: matched official Windows CPU version/build ${version} (${build_hash}).")
endfunction()
function(copy_qt_licenses qt_bin stage)
    get_filename_component(qt_root "${qt_bin}" DIRECTORY)
    file(GLOB licenses LIST_DIRECTORIES FALSE "${qt_root}/LICENSE*" "${qt_root}/NOTICE*")
    foreach(folder licenses LICENSES doc/licenses doc/global/licenses)
        file(GLOB_RECURSE nested LIST_DIRECTORIES FALSE "${qt_root}/${folder}/*")
        list(APPEND licenses ${nested})
    endforeach()
    list(REMOVE_DUPLICATES licenses)
    if(licenses)
        foreach(license IN LISTS licenses)
            file(RELATIVE_PATH relative "${qt_root}" "${license}")
            get_filename_component(parent "${relative}" DIRECTORY)
            file(MAKE_DIRECTORY "${stage}/licenses/Qt/${parent}")
            file(COPY "${license}" DESTINATION "${stage}/licenses/Qt/${parent}")
        endforeach()
        return()
    endif()

    # aqt installs the binary archives; their SDK directory can lack notices.
    # qconfig.pri is generated by Qt from PROJECT_VERSION, independently of setup.
    if(NOT EXISTS "${qt_root}/mkspecs/qconfig.pri")
        message(FATAL_ERROR "Qt notices are absent and mkspecs/qconfig.pri is missing from ${qt_root}.")
    endif()
    file(STRINGS "${qt_root}/mkspecs/qconfig.pri" version_line REGEX "^QT_VERSION[ \t]*=")
    if(NOT version_line MATCHES "^QT_VERSION[ \t]*=[ \t]*([0-9]+\\.[0-9]+\\.[0-9]+)[ \t]*$")
        message(FATAL_ERROR "Cannot identify the Qt version for notice packaging: ${qt_root}")
    endif()
    set(version "${CMAKE_MATCH_1}")
    set(bundle "${SOURCE}/third_party/qt-notices/${version}")
    if(NOT EXISTS "${bundle}/provenance.json")
        message(FATAL_ERROR "Qt ${version} has no matching notice bundle: ${bundle}")
    endif()
    file(READ "${bundle}/provenance.json" provenance)
    string(JSON format GET "${provenance}" format)
    string(JSON notice_version GET "${provenance}" qt_version)
    if(NOT format STREQUAL "fingerprint-qt-notices-v1" OR NOT version STREQUAL notice_version)
        message(FATAL_ERROR "Qt notice version does not match ${version}.")
    endif()
    set(notice "${bundle}/LICENSES.txt")
    if(NOT EXISTS "${notice}")
        message(FATAL_ERROR "Qt notice bundle is incomplete: ${notice}")
    endif()
    string(JSON expected GET "${provenance}" notice_sha256)
    file(SHA256 "${notice}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Qt notice SHA-256 mismatch: ${notice}")
    endif()
    file(MAKE_DIRECTORY "${stage}/licenses/Qt")
    file(COPY "${notice}" "${bundle}/provenance.json" DESTINATION "${stage}/licenses/Qt")
    message(STATUS "Qt notices: matched official source version ${version} (Base, SVG, Image Formats).")
endfunction()
function(write_manifest stage)
    file(GLOB_RECURSE packaged RELATIVE "${stage}" LIST_DIRECTORIES FALSE "${stage}/*")
    list(SORT packaged)
    set(manifest "")
    foreach(path IN LISTS packaged)
        if(path STREQUAL "SHA256SUMS.txt")
            continue()
        endif()
        file(SHA256 "${stage}/${path}" digest)
        string(APPEND manifest "${digest}  ${path}\n")
    endforeach()
    file(WRITE "${stage}/SHA256SUMS.txt" "${manifest}")
endfunction()
