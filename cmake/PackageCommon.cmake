function(check_destination)
    if(NOT DESTINATION OR NOT SOURCE)
        message(FATAL_ERROR "Package destination and source are required.")
    endif()
    get_filename_component(destination "${DESTINATION}" ABSOLUTE)
    get_filename_component(source "${SOURCE}" ABSOLUTE)
    # A package output may never replace source, original data, or its own inputs.
    cmake_path(IS_PREFIX destination "${source}" NORMALIZE contains_source)
    set(original "${source}/data/original")
    cmake_path(IS_PREFIX original "${destination}" NORMALIZE inside_original)
    foreach(input IN ITEMS "${ALGORITHM_DLL}" "${CORE_DLL}" "${WORKER_EXE}" "${GUI_EXE}" "${MODELS}")
        if(input)
            cmake_path(IS_PREFIX destination "${input}" NORMALIZE contains_input)
            if(contains_input)
                message(FATAL_ERROR "Package destination would replace input: ${input}")
            endif()
        endif()
    endforeach()
    if(contains_source OR inside_original)
        message(FATAL_ERROR "Package destination would replace protected source/original data.")
    endif()
endfunction()
function(copy_qt_licenses qt_bin stage)
    get_filename_component(qt_root "${qt_bin}" DIRECTORY)
    file(GLOB licenses "${qt_root}/LICENSE*" "${qt_root}/licenses/*")
    if(NOT licenses)
        message(FATAL_ERROR "Qt license files missing from ${qt_root}.")
    endif()
    foreach(license IN LISTS licenses)
        file(RELATIVE_PATH relative "${qt_root}" "${license}")
        get_filename_component(parent "${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${stage}/licenses/Qt/${parent}")
        file(COPY "${license}" DESTINATION "${stage}/licenses/Qt/${parent}")
    endforeach()
endfunction()
function(write_manifest stage)
    file(GLOB_RECURSE packaged RELATIVE "${stage}" LIST_DIRECTORIES FALSE "${stage}/*")
    list(SORT packaged)
    set(manifest "")
    foreach(path IN LISTS packaged)
        if(path STREQUAL "SHA256SUMS.txt")
            continue()
        endif()
        file(SHA256 "${stage}/${path}" digest)
        string(APPEND manifest "${digest}  ${path}\n")
    endforeach()
    file(WRITE "${stage}/SHA256SUMS.txt" "${manifest}")
endfunction()
