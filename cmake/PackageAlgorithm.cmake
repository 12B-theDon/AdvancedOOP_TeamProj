cmake_minimum_required(VERSION 3.21)
# Validate before creating/replacing any deployment output.
include("${CMAKE_CURRENT_LIST_DIR}/PackageCommon.cmake")
foreach(model fvc2000_db3 fvc2002_db3 fvc2004_db1 combined)
    if(NOT EXISTS "${MODELS}/${model}.bin")
        message(FATAL_ERROR "Missing production weight: ${MODELS}/${model}.bin. Restore existing weights; packaging never retrains.")
    endif()
endforeach()
foreach(binary ALGORITHM_DLL CORE_DLL WORKER_EXE QT_CORE)
    if(NOT EXISTS "${${binary}}")
        message(FATAL_ERROR "Missing required binary: ${binary}")
    endif()
endforeach()
check_destination()
get_filename_component(qt_bin "${QT_CORE}" DIRECTORY)
file(GET_RUNTIME_DEPENDENCIES
    LIBRARIES "${ALGORITHM_DLL}" "${CORE_DLL}"
    EXECUTABLES "${WORKER_EXE}"
    DIRECTORIES "${qt_bin}" "${TORCH_ROOT}/lib"
    RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR missing
    PRE_EXCLUDE_REGEXES "[Aa][Pp][Ii]-[Mm][Ss]-.*" "[Ee][Xx][Tt]-[Mm][Ss]-.*"
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\].*")
if(missing)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${missing}")
endif()
set(stage "${DESTINATION}.staging")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/licenses")
file(COPY "${ALGORITHM_DLL}" "${CORE_DLL}" "${WORKER_EXE}" ${dependencies} ${CRT_FILES} DESTINATION "${stage}")
foreach(model fvc2000_db3 fvc2002_db3 fvc2004_db1 combined)
    file(COPY "${MODELS}/${model}.bin" DESTINATION "${stage}")
endforeach()
file(COPY "${SOURCE}/src/Kisa/README.txt" "${SOURCE}/tools/verify_manifest.py" DESTINATION "${stage}")
file(COPY "${SOURCE}/third_party/deepprint/LICENSE" DESTINATION "${stage}/licenses")
file(RENAME "${stage}/licenses/LICENSE" "${stage}/licenses/DeepPrint-LGPL-3.0.txt")
file(COPY "${SOURCE}/third_party/deepprint.NOTICE.txt" "${SOURCE}/docs/THIRD_PARTY.md" "${SOURCE}/docs/InceptionV4-BSD-3-Clause.txt" DESTINATION "${stage}/licenses")
file(GLOB_RECURSE torch_licenses "${TORCH_ROOT}/*LICENSE*" "${TORCH_ROOT}/*NOTICE*")
if(NOT torch_licenses)
    message(FATAL_ERROR "LibTorch license files missing from ${TORCH_ROOT}")
endif()
file(MAKE_DIRECTORY "${stage}/licenses/LibTorch")
foreach(license IN LISTS torch_licenses)
    file(RELATIVE_PATH relative "${TORCH_ROOT}" "${license}")
    get_filename_component(parent "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${stage}/licenses/LibTorch/${parent}")
    file(COPY "${license}" DESTINATION "${stage}/licenses/LibTorch/${parent}")
endforeach()
copy_qt_licenses("${qt_bin}" "${stage}")
write_manifest("${stage}")
# Only replace the explicitly configured deployment directory after validation.
file(REMOVE_RECURSE "${DESTINATION}")
file(RENAME "${stage}" "${DESTINATION}")
message(STATUS "Packaged ${DESTINATION}; manifest excludes only itself.")
