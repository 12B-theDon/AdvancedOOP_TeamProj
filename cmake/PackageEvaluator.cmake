cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/PackageCommon.cmake")
check_destination()
foreach(input GUI_EXE WORKER_EXE INSTALLER_EXE WINDEPLOYQT)
    if(NOT EXISTS "${${input}}")
        message(FATAL_ERROR "Missing evaluator input: ${input}")
    endif()
endforeach()
set(stage "${DESTINATION}.staging")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/licenses")
get_filename_component(qt_bin "${WINDEPLOYQT}" DIRECTORY)
copy_qt_licenses("${qt_bin}" "${stage}")
file(COPY "${GUI_EXE}" "${WORKER_EXE}" "${SOURCE}/src/GUI/README.txt"
    "${SOURCE}/tools/verify_manifest.py" DESTINATION "${stage}")
file(COPY_FILE "${INSTALLER_EXE}" "${stage}/install.exe")
get_filename_component(executable "${GUI_EXE}" NAME)
execute_process(COMMAND "${WINDEPLOYQT}" --release --no-translations "${stage}/${executable}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "windeployqt failed: ${result}")
endif()
file(GLOB tiff "${stage}/imageformats/*tiff*.dll")
if(NOT tiff)
    message(FATAL_ERROR "Qt TIFF plugin is missing; install/deploy it before packaging.")
endif()
file(COPY "${SOURCE}/docs/THIRD_PARTY.md" DESTINATION "${stage}/licenses")
publish_package("${stage}")
message(STATUS "Packaged ${DESTINATION}")
