cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/PackageCommon.cmake")
if(NOT EXISTS "${ISCC}")
    message(FATAL_ERROR "Inno Setup ISCC.exe was not found. Install Inno Setup 6.3+ on the build machine or set FINGERPRINT_ISCC.")
endif()
if(NOT EXISTS "${UNINSTALL_EXE}")
    message(FATAL_ERROR "Uninstall.exe is missing. Build FingerprintUninstall or supply a complete existing installer payload.")
endif()
file(MAKE_DIRECTORY "${PAYLOAD}")
get_filename_component(uninstall_source "${UNINSTALL_EXE}" ABSOLUTE)
get_filename_component(uninstall_target "${PAYLOAD}/Uninstall.exe" ABSOLUTE)
if(NOT uninstall_source STREQUAL uninstall_target)
    file(COPY_FILE "${UNINSTALL_EXE}" "${PAYLOAD}/Uninstall.exe")
endif()
foreach(relative FingerprintEvaluator/FingerprintGUI.exe FingerprintEvaluator/FingerprintWorker.exe
    FingerprintAlgorithm/FingerprintAlgorithm.dll FingerprintAlgorithm/FingerprintAlgorithmCore.dll
    FingerprintAlgorithm/fvc2000_db3.bin FingerprintAlgorithm/fvc2002_db3.bin FingerprintAlgorithm/fvc2004_db1.bin FingerprintAlgorithm/combined.bin)
    if(NOT EXISTS "${PAYLOAD}/${relative}")
        message(FATAL_ERROR "Missing clean installer payload: ${relative}. Build both package targets first.")
    endif()
endforeach()
# Bundle precisely the 240 original FVC examples, never local inference/augmentation files.
foreach(database FVC2000_DB3_B FVC2002_DB3_B FVC2004_DB1_B)
    file(MAKE_DIRECTORY "${PAYLOAD}/data/original/${database}")
    foreach(finger RANGE 101 110)
        foreach(capture RANGE 1 8)
            set(name "${finger}_${capture}.tif")
            if(NOT EXISTS "${SOURCE}/data/original/${database}/${name}")
                message(FATAL_ERROR "Missing original example: ${database}/${name}")
            endif()
            file(COPY_FILE "${SOURCE}/data/original/${database}/${name}" "${PAYLOAD}/data/original/${database}/${name}")
        endforeach()
    endforeach()
endforeach()
file(GLOB_RECURSE files RELATIVE "${PAYLOAD}" LIST_DIRECTORIES FALSE "${PAYLOAD}/FingerprintAlgorithm/*" "${PAYLOAD}/FingerprintEvaluator/*" "${PAYLOAD}/data/original/*" "${PAYLOAD}/Uninstall.exe")
list(SORT files)
list(LENGTH files count)
set(code "procedure PopulateFiles;\nbegin\n  SetArrayLength(ExpectedFiles, ${count});\n  SetArrayLength(ExpectedHashes, ${count});\n")
set(index 0)
foreach(relative IN LISTS files)
    if(IS_SYMLINK "${PAYLOAD}/${relative}")
        message(FATAL_ERROR "Installer payload may not contain symlinks.")
    endif()
    file(SHA256 "${PAYLOAD}/${relative}" digest)
    string(REPLACE "/" "\\" pascal_path "${relative}")
    string(REPLACE "'" "''" pascal_path "${pascal_path}")
    string(APPEND code "  ExpectedFiles[${index}] := '${pascal_path}';\n  ExpectedHashes[${index}] := '${digest}';\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND code "end;\n")
file(WRITE "${PAYLOAD}/expected_files.iss" "${code}")
file(MAKE_DIRECTORY "${OUTPUT}")
execute_process(COMMAND "${ISCC}" "/DPayload=${PAYLOAD}" "/DSetupOutput=${OUTPUT}"
    "${CMAKE_CURRENT_LIST_DIR}/FingerprintSetup.iss" RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR NOT EXISTS "${OUTPUT}/install.exe")
    message(FATAL_ERROR "Inno Setup packaging failed: ${status}")
endif()
file(SHA256 "${OUTPUT}/install.exe" digest)
file(WRITE "${OUTPUT}/SHA256SUMS.txt" "${digest}  install.exe\n")
file(COPY_FILE "${PAYLOAD}/Uninstall.exe" "${OUTPUT}/Uninstall.exe")
file(SHA256 "${OUTPUT}/Uninstall.exe" uninstall_digest)
file(APPEND "${OUTPUT}/SHA256SUMS.txt" "${uninstall_digest}  Uninstall.exe\n")
# Preserve the requested portable layout too; never replace the source installer in use.
set(portable "${SOURCE}/dist/FingerprintEvaluator")
if(EXISTS "${portable}/FingerprintGUI.exe")
    get_filename_component(running "${RUNNING_INSTALLER}" ABSOLUTE)
    get_filename_component(target "${portable}/install.exe" ABSOLUTE)
    string(TOLOWER "${running}" running)
    string(TOLOWER "${target}" target)
    if(NOT running STREQUAL target)
        file(COPY_FILE "${OUTPUT}/install.exe" "${portable}/install.exe")
        write_manifest("${portable}")
    endif()
endif()
message(STATUS "Windows wizard: ${OUTPUT}/install.exe (SHA-256 ${digest})")
message(STATUS "Windows uninstaller launcher: ${OUTPUT}/Uninstall.exe (SHA-256 ${uninstall_digest})")
